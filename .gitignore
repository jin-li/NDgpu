# Python bytecode and caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build/venv
build/
*.egg
.venv/
venv/
.cache/

# Note: dist/garnet-src.zip is a tracked deliverable (uploaded to Colab), so
# dist/ is intentionally NOT ignored.

# Local reference copies of papers (not redistributable) + Windows ADS junk
docs/*.pdf
*Zone.Identifier
results/

# Claude Code scratch worktrees
.claude/worktrees/

# preCICE run artifacts (examples/precice/run.sh writes these into its workdir)
examples/precice/run/
precice-run/
precice-profiling/
precice-*-iterations.log
precice-*-convergence.log

# Local research repositories, worktrees, and simulation campaigns
/.scratch/

# Independent study repositories may remain private.
/studies/

# Generated Serpent files (keep authored input decks and includes trackable)
*_res.m
*_det*.m
*_his*.m
*_dep.m
*_mdx*.m
*_bumat*
*.seed
*.wrn

# Transient Serpent logs and run metadata beside example inputs
/examples/serpent-xs/**/*.log
/examples/serpent-xs/**/*.out
/examples/serpent-xs/**/*.err

# Generated manuals
/docs/_build/
